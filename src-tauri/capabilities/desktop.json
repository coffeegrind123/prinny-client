{
  "identifier": "desktop-capability",
  "description": "Desktop-only permissions granted to the bundled frontend origin. Keep this list to what the frontend actually calls: this capability is granted to the remote origin below, so anything listed here is reachable by whatever executes script in the page.",
  "local": true,
  "remote": {
    "urls": [
      "http://localhost:44548"
    ]
  },
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "notification:default",
    "notification:allow-register-action-types",
    "notification:allow-register-listener",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "core:tray:default",
    "core:tray:allow-new",
    "core:tray:allow-set-icon",
    "core:tray:allow-set-menu",
    "core:tray:allow-set-tooltip",
    "core:tray:allow-set-show-menu-on-left-click",
    "core:menu:default",
    "core:app:allow-default-window-icon",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "deep-link:default",
    "deep-link:allow-get-current",
    "allow-send-windows-message-toast",
    "allow-start-rich-presence-bridge",
    "allow-stop-rich-presence-bridge"
  ]
}
