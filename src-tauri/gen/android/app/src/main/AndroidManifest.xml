<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Element Call (in-room voice/video) — Android 14+ requires this for
         mic capture from a foreground service so the WebSocket+mic survives
         backgrounding mid-call. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- WebRTC capture for Element Call. Declared so the WebView's
         PermissionRequest for RESOURCE_AUDIO_CAPTURE / VIDEO_CAPTURE can
         be granted by MainActivity's WebChromeClient override. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Bluetooth headset routing during calls. Runtime BLUETOOTH_CONNECT
         only matters from Android 12+; declared as not-required so older
         devices can install without the feature. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Camera/mic are optional — most users will only use voice, and TV
         devices generally lack a camera. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- android:allowBackup="false" — the app stores Matrix session material
         (access token, E2EE device keys) in its private data dir. adb backup /
         cloud auto-backup would copy that off the device, so backups are
         disabled outright.
         android:networkSecurityConfig — cleartext is denied app-wide there,
         with a carve-out for loopback only (the bundled frontend on
         127.0.0.1:44548). The usesCleartextTraffic placeholder stays wired up
         (build.gradle.kts now sets it to "false") so the two flags agree; the
         network security config is the authoritative one from API 24 up. -->
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.cinny"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- android:taskAffinity="" — with minSdk 24 the API 24-29 range is
             still open to StrandHogg-style task hijacking, where a malicious
             app declares our task affinity and gets its own activity placed in
             our task to phish the login UI. An empty affinity puts this
             activity in a task nothing else can join by name. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:taskAffinity=""
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- `matrix:` URIs (MSC2312) from other apps open a room or user
                 here. The desktop deep-link plugin registers its schemes from
                 tauri.conf.json, but Android resolves handlers from the
                 manifest, so the filter has to be declared explicitly.

                 BROWSABLE is required for links tapped in a browser or another
                 app to reach us at all; without it this only matches explicit
                 intents and looks like the registration silently failed. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="matrix" />
            </intent-filter>

            <!-- `prinny://bot/@bot:server?start=payload` — bot deep links, the
                 equivalent of Telegram's t.me/bot?start=. The shareable form of
                 the same link is https://prinny.app/bot/…, but an https link
                 opened outside the app goes to the browser: catching it here
                 instead would need Android App Links, i.e. autoVerify plus a
                 hosted assetlinks.json. A custom scheme costs one filter. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="prinny" />
            </intent-filter>

            <!-- System share sheet. These are what put Prinny in the "Share"
                 list of every other app on the device; MainActivity turns the
                 intent into a payload and ShareTargetPlugin hands it to the
                 frontend, which opens a room picker.

                 `*/*` rather than an enumerated list: a Matrix room accepts any
                 file, so narrowing the list only means Prinny is missing from
                 the sheet for whatever was left out. text/plain is declared
                 separately because a text share carries no stream at all and
                 some senders match the filter literally.

                 This filter is why the activity must keep treating intent
                 extras as hostile — any app can now reach it with arbitrary
                 text and arbitrary content URIs. Nothing is auto-sent: the
                 payload lands in a composer the user still has to confirm. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- UnifiedPush receiver -->
        <receiver
            android:name=".UnifiedPushReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
            </intent-filter>
        </receiver>

        <!-- Foreground service: keeps Matrix WebSocket alive on GrapheneOS (no FCM)
             AND covers microphone capture for Element Call when the app is
             backgrounded mid-call. Android 14+ requires the type bitmask to
             match the runtime startForeground() call exactly. -->
        <service
            android:name=".ForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync|microphone" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
