save-exact=true

# Dependency lifecycle scripts (preinstall/install/postinstall) run arbitrary
# code from every transitive package at install time — in CI that code would
# run in the same job as TAURI_SIGNING_PRIVATE_KEY and the Android signing
# secrets. Verified safe here: the only packages in this tree with install
# scripts are esbuild (bin-shim optimisation) and @swc/core (binary
# validation + wasm fallback); both resolve their native binary from the
# platform-specific optional dependency at runtime, which `npm ci` installs
# from the lockfile regardless of this setting.
#
# NOTE: npm reads the project .npmrc from the nearest package.json directory
# only — this file does NOT apply to `cd cinny && npm ci` (the submodule is its
# own project and must not be edited from here). Those invocations pass
# `--ignore-scripts` explicitly in .github/workflows/build.yml.
ignore-scripts=true
